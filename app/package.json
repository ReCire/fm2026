    "svelte": "^5.2.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "zod": "^3.23.8"
  }
}
